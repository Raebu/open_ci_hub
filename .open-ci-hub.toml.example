# Copy to .open-ci-hub.toml only after reviewing the commands and approving the image locally.
version = 1
image = "python:3.12-slim"
network = "none"
memory_mb = 1024
cpus = 1.0
timeout_seconds = 600
artifacts = []

[[steps]]
name = "unit tests"
stage = "test"
run = "python -m unittest discover -s tests -v"
timeout_seconds = 600

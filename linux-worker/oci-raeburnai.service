[Unit]
Description=RaeburnAI Qwen3.5 2B local-only quantised inference
After=local-fs.target
ConditionPathExists=/opt/open-ci-hub/ai/RaeburnAI-Qwen3.5-2B-Q4_K_M.gguf

[Service]
Type=simple
User=ociworker
Group=ociworker
WorkingDirectory=/opt/open-ci-hub/ai/llama-b11969
ExecStart=/opt/open-ci-hub/ai/llama-b11969/llama-server --model /opt/open-ci-hub/ai/RaeburnAI-Qwen3.5-2B-Q4_K_M.gguf --host 127.0.0.1 --port 8879 --ctx-size 1024 --threads 5 --threads-batch 5 --parallel 1 --gpu-layers 0
Restart=on-failure
RestartSec=15
MemoryMax=2300M
CPUQuota=550%
TasksMax=160
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target

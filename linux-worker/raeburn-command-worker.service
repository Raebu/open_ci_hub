[Unit]
Description=RaeburnAI governed mission executor (one fixed action per run)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/raeburn_command_centre.py

[Service]
Type=oneshot
WorkingDirectory=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub
Environment=PATH=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/linux-worker/raeburn-ssh-bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/raeburn_command_centre.py work
TimeoutStartSec=115
MemoryMax=192M
CPUQuota=45%
TasksMax=48
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
UMask=0077

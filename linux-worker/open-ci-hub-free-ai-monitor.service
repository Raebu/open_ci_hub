[Unit]
Description=Open CI Hub verify free AI provider access without inference
After=network-online.target
Wants=network-online.target
ConditionPathExists=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/free_ai_router.py

[Service]
Type=oneshot
WorkingDirectory=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub
ExecStart=/usr/bin/python3 /mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/free_ai_router.py monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
UMask=0077
MemoryMax=256M
CPUQuota=30%
TasksMax=48
Nice=10
TimeoutStartSec=90

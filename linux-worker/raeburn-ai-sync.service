[Unit]
Description=RaeburnAI read-only business transaction metadata ingestion
After=network.target
ConditionPathExists=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/raeburn_ai.py

[Service]
Type=oneshot
WorkingDirectory=/mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub
ExecStart=/usr/bin/python3 /mnt/kingston/home/theraeburngroup/Code_Projects/open-ci-hub/raeburn_ai.py sync
TimeoutStartSec=45
CPUQuota=20%
MemoryMax=128M
TasksMax=32
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0077

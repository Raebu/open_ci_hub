[Unit]
Description=Samsung Galaxy Book Go native Wi-Fi Qualcomm modem recovery
Documentation=https://github.com/Raebu/open_ci_hub
Requires=rmtfs.service tqftpserv.service
After=local-fs.target rmtfs.service tqftpserv.service
Wants=NetworkManager.service
ConditionPathExists=/sys/class/remoteproc/remoteproc0/state
StartLimitIntervalSec=900
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/oci-samsung-wifi-start
TimeoutStartSec=125
Nice=12
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
